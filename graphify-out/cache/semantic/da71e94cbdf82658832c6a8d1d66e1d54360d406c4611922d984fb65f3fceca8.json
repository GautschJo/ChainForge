{"nodes": [{"id": "readme_chainforge", "label": "ChainForge", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately general-purpose, not built for a specific API or LLM back-end; ultimate goal is integration into other tools for systematic evaluation and auditing of LLMs. Focuses on evaluation across prompts, prompt parameters, and models, unlike the closed-source PromptChainer/AI Chains projects that inspired it."}, {"id": "readme_prompt_permutations", "label": "Prompt Permutations (Combinatorial Cross Product)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Taking the cross product of inputs to prompt templates sends hundreds of queries at once, verifying model behavior more robustly than one-off prompting; templates can chain at arbitrary depth to compare templates themselves."}, {"id": "readme_model_settings", "label": "Model Settings Comparison", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multiple nicknamed copies of the same model with different settings let users measure e.g. the impact of a system message on ChatGPT."}, {"id": "readme_evaluation_nodes", "label": "Evaluation Nodes", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Python-script-based probing of LLM responses; LLM responses can be chained into prompt templates to evaluate outputs cheaply before more extensive evaluation."}, {"id": "readme_visualization_nodes", "label": "Visualization Nodes", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grouped box-and-whisker for numeric metrics and histograms for boolean metrics; only numeric and boolean metrics supported at time of writing."}, {"id": "readme_chat_turns", "label": "Chat Turns Templating", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Follow-up chat messages are templated just like prompts, enabling comparison of later responses across chat models or settings."}, {"id": "readme_share_feature", "label": "Flow Share Feature", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "To prevent abuse, only 10 flows may be shared at a time and each must be under 5MB compressed; oldest link breaks beyond 10, so users are told to export important flows to cforge files and use Share only ephemerally."}, {"id": "readme_web_version", "label": "ChainForge Web Version (chainforge.ai/play)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hosted version has a limited feature set; local install adds env-var API keys, Python code evaluation, and locally-run Ollama models."}, {"id": "readme_supported_providers", "label": "Supported LLM Providers", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OpenAI, Anthropic, Google Gemini, DeepSeek, HuggingFace, Together.ai, Ollama, Azure OpenAI, Aleph Alpha, Amazon Bedrock, plus arbitrary providers via custom provider scripts."}, {"id": "readme_reactflow", "label": "ReactFlow", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author"